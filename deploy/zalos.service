[Unit]
Description=zalos Zalo proxy server
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=zalos
Group=zalos
StateDirectory=zalos
StateDirectoryMode=0700
Environment=ZALOS_DATA_DIR=/var/lib/zalos
Environment=ZALOS_UNIT=zalos.service
ExecStart=/usr/local/bin/bun /opt/zalos/src/cli.ts serve
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
