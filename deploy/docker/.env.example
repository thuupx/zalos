# Copy to .env and adjust. .env is git-ignored.

# Optional pre-authorized tailnet key. When empty, the tailscale container
# prints a login URL in its logs that you approve in the browser.
TS_AUTHKEY=

# Name this node gets on the tailnet.
TS_HOSTNAME=zalos

TZ=Asia/Ho_Chi_Minh

# Port the Noise tunnel listens on (tailnet only, never published).
ZALOS_PORT=7443
